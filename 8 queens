N = 8
board = [[0] * N for _ in range(N)]
board[0][0] = 1

def safe(row, col):
    for i in range(row):
        if board[i][col]:
            return False
        if col-(row-i) >= 0 and board[i][col-(row-i)]:
            return False
        if col+(row-i) < N and board[i][col+(row-i)]:
            return False
    return True

def solve(row):
    if row == N:
        return True

    for col in range(N):
        if safe(row, col):
            board[row][col] = 1

            if solve(row + 1):
                return True

            board[row][col] = 0

    return False

if solve(1):
    for row in board:
        print(" ".join("Q" if x else "." for x in row))
else:
    print("No solution")
