jobs = [('A', 2, 100), ('B', 1, 19),
        ('C', 2, 27), ('D', 1, 25), ('E', 3, 15)]

jobs.sort(key=lambda x: x[2], reverse=True)

slots = [None] * 3
profit = 0

for job in jobs:
    for i in range(job[1] - 1, -1, -1):
        if slots[i] is None:
            slots[i] = job[0]
            profit += job[2]
            break

print("Jobs:", slots)
print("Maximum Profit:", profit)
